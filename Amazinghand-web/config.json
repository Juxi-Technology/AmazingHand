{
  "//": "AmazingHand 网页控制 —— 舵机与姿态配置",
  "//1": "数据来源：github组织仓库/AmazingHand/AmazingHandControl/data/*.yaml",
  "//2": "换算（与其官方实现一致）：",
  "//3": "  1) 左手先交换每根手指两个舵机的值（mirror_pose）",
  "//4": "  2) servo_deg = (id 为奇数 ? +1 : -1) × (姿态值 - angle_offset_deg)",
  "//5": "  右手 angle_offset_deg = 0，左手 = -35.16（舵机臂错开半格）",
  "//6": "姿态数组顺序固定为 [无名指, 中指, 食指, 拇指]，每根手指 2 个值，与源文件一致。",
  "serial": {
    "//": "留空则自动探测；也可用 --port 或环境变量覆盖",
    "port": "",
    "baudrate": 1000000,
    "timeout_s": 0.5
  },
  "limits": {
    "//": "姿态值上下限（度）。左手 close 需要 ±110.16°，所以放到 ±120；SCS0009 满量程约 ±150°。",
    "pose_min_deg": -120.0,
    "pose_max_deg": 120.0,
    "//speed": "1(最慢) ~ 6(最快)",
    "speed": 3
  },
  "axes": {
    "//": "每根手指两个舵机的分工（官方约定，见 AmazingHandControl/docs/CONFIG_FORMAT.md）：",
    "//2": "  屈伸轴 = 位置轴(servo1, 奇数ID)，负责张开/握紧；范围由 20 个姿态统计得出 -39~+75",
    "//3": "  侧摆轴 = 左右轴(servo2, 偶数ID)，负责手指之间张开/并拢；统计范围 -36~+30",
    "//4": "  界面上按这两个轴显示。下发时合成： servo1 = 屈伸 + 侧摆， servo2 = 屈伸 − 侧摆",
    "flexion": {
      "label": "屈伸",
      "min": -50,
      "max": 90,
      "//": "张开(负) ↔ 握紧(正)"
    },
    "spread": {
      "label": "侧摆",
      "min": -45,
      "max": 45,
      "//": "并拢(负) ↔ 张开(正)，左右手由 mirror 自动处理"
    }
  },
  "camera": {
    "//": "摄像头互动遥控的两根轴的目标值 —— 端点由三步引导采集实测",
    "//2": "屈伸轴：① 伸直 -> ③ 握拳",
    "//3": "侧摆轴：② 合拢 -> ① 张开（两端方向相反，不是同一端）。拇指不参与侧摆，只做屈伸",
    "//4": "四指顺序固定：无名指 / 中指 / 食指 / 拇指",
    "//5": "side_sign：左右手侧摆方向相反时用。1 = 原样，-1 = 整根侧摆轴取反。",
    "//6": "下面两组是两只手共用的基准值；哪只手方向反了，就把 side_sign 里那只手改成 -1。",
    "flex_straight": -50,
    "flex_fist": {
      "ring": 90,
      "middle": 90,
      "pointer": 90,
      "thumb": 18
    },
    "side_spread": {
      "ring": 45,
      "middle": 0,
      "pointer": -45
    },
    "side_together": {
      "ring": -45,
      "middle": 0,
      "pointer": 45
    },
    "side_sign": {
      "//": "按「控制对象」选的那只手生效",
      "right": 1,
      "left": -1
    }
  },
  "hands": {
    "right": {
      "label": "右手",
      "angle_offset_deg": 0.0,
      "//mirror_pose": "本机右手模组的舵机对也是反装的，所以和左手一样要交换配对。交换只翻侧摆、不动屈伸。",
      "mirror_pose": true,
